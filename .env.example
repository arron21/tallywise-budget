# Database (Vercel Postgres / Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tallywise?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Plaid Credit Card Sync (Sandbox / Development / Production)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Full HTTPS URL to /api/plaid/webhook (on Vercel: https://your-app.vercel.app/api/plaid/webhook)
PLAID_WEBHOOK_URL=""
# Optional 32-byte hex or base64 key for encrypting Plaid access tokens at rest
TOKEN_ENCRYPTION_KEY=""

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@tallywise.app"
